# Copy to env.local and source before running curl examples:
#   source scripts/integration/env.local

# Payment service base URL (no trailing slash)
export PAYMENT_SERVICE_BASE_URL="http://localhost:8080"

# Admin API key — must match server authentication_key / APP_AUTHENTICATION_KEY
# Inject via CI/CD secret store; never commit the real value.
export PAYMENT_SERVICE_AUTH_KEY="dev-admin-key-change-me"
